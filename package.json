{
  "name": "ryans-store-product-stock-extension",
  "displayName": "Ryans Stock Checker",
  "version": "0.0.1",
  "description": "Shows Ryans Computers store stock availability on product pages and category product cards.",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "^0.89.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  },
  "manifest": {
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://www.ryans.com/*"
    ]
  }
}
